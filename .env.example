# ===========================================================================
# Vernify Bootstrap Container — secrets template
#
# Copy this file to .env and fill in the real values. Docker Compose will
# automatically load this file.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose run -it --rm bootstrap
#
# All values here are TRANSIENT — they are seeded into Vault during Phase 3
# and this file (and the container) are retired at Phase 5.
# ===========================================================================

# ---------------------------------------------------------------------------
# Workspace path
# Used for: Mounting the entire ~/workspace into /workspace inside container
# ---------------------------------------------------------------------------
export BOOTSTRAP_WORKSPACE_PATH=/Users/wernervandermerwe/workspace

# ---------------------------------------------------------------------------
# Proxmox
# Used for: Packer image builds (Phase 1) + Terraform VM provisioning (Phase 2)
#
# Format:  standard Proxmox username and password.
# User format:    user@realm (e.g. root@pam)
# Node name:      the Proxmox node where VMs will be built (e.g. pve, pve01, etc.)
# Storage:        the datastore/storage pool for VM images (e.g. local, local-lvm)
# ---------------------------------------------------------------------------
export PROXMOX_URL="https://pve08.vernify.com:8006"
export PROXMOX_USER="root@pam"
export PROXMOX_PASSWORD="your-proxmox-password"
export PROXMOX_NODE="pve"
export PROXMOX_STORAGE="local-lvm"     # Storage pool for VM disks (must support images)
export PROXMOX_ISO_STORAGE="local"     # Storage pool for ISOs — ISOs are cached here after first download

# Proxmox API token (for Telmate/proxmox provider in Terraform)
# Generate at: https://pve08.vernify.com:8006/#v1:/access/tokens
# Format: token-name!token-uuid
export PROXMOX_API_TOKEN_ID="name@pam!user-token"
export PROXMOX_API_TOKEN_SECRET="your-proxmox-api-token-secret"

# ---------------------------------------------------------------------------
# Terraform Cloud
# Used for: Creating TFC workspaces and running plans (Phase 2+)
#
# Generate at: https://app.terraform.io/app/settings/tokens
# Scope:       Team token for the Vernify TFC organisation.
#
# This single value is mapped by entrypoint.sh to the two env vars Terraform
# actually reads:
#   - TF_TOKEN_app_terraform_io  (cloud {} backend auth — used by the
#     terraform-sec01-deploy / terraform-build01-deploy / terraform-agent01-deploy
#     per-host repos)
#   - TFE_TOKEN                  (the `tfe` provider — used by
#     terraform-workspaces-deploy, which creates those repos' TFC workspaces)
# ---------------------------------------------------------------------------
export TFC_TOKEN="your-tfc-team-token"

# ---------------------------------------------------------------------------
# GitHub
# Used for: Cloning Vernify IaC repos and blueprints.* sources during build.
#
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (read), read:org
# ---------------------------------------------------------------------------
export GIT_PAT="github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# step-ca / PKI
# Used for: Standing up the PKI root and provisioner on sec01 (Phase 3).
#
# This is the password for the step-ca ACME/JWK provisioner.
# Keep it safe — it is the root of trust for all internal TLS.
# ---------------------------------------------------------------------------
export STEP_CA_PROVISIONER_PASSWORD="your-step-ca-provisioner-password"

# ---------------------------------------------------------------------------
# SSH — first-boot access to provisioned VMs
# Used for: Ansible connecting to freshly provisioned VMs before Vault/certs.
#
# Option A (recommended): mount the key file via docker-compose.yml volumes.
#   BOOTSTRAP_SSH_KEY_FILE is the path inside the container (default shown).
#
# Option B: supply as a base64-encoded string (useful in CI / secrets stores).
#   BOOTSTRAP_SSH_PRIVATE_KEY_B64=$(base64 -w0 < ~/.ssh/id_vernify_bootstrap)
#
# Only one option is needed.
# ---------------------------------------------------------------------------
export BOOTSTRAP_SSH_KEY_FILE="/run/secrets/bootstrap_ssh_key"
# export BOOTSTRAP_SSH_PRIVATE_KEY_B64="$(base64 -w0 < ~/.ssh/id_vernify_bootstrap)"

# ---------------------------------------------------------------------------
# Packer — template build configuration
# Used for: Building VM templates in Phase 1
#
# vm_name:         The name/version of the template being built (e.g. ubuntu-24.04)
# iso_filename:    The ISO file to boot from (must exist in PROXMOX_ISO_STORAGE)
# ---------------------------------------------------------------------------
export PKR_VAR_vm_name="ubuntu-24.04"
export PKR_VAR_iso_filename="ubuntu-24.04.4-live-server-amd64.iso"

# ---------------------------------------------------------------------------
# Vault (populated in Phase 3 — leave blank until Vault is up)
# ---------------------------------------------------------------------------
export VAULT_ADDR=""
export VAULT_TOKEN=""
